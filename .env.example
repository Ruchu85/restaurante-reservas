# Supabase — obtenidos en https://supabase.com/dashboard/project/<id>/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Sólo necesario para scripts de servidor (nunca en el cliente)
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# URL base de la app (sin barra final)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Slug del restaurante por defecto (debe coincidir con la tabla restaurants)
NEXT_PUBLIC_RESTAURANT_SLUG=restaurante-demo

# Email transaccional — Resend (https://resend.com · free: 3 000 emails/mes)
# Deja vacío para deshabilitar emails de confirmación/cancelación
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=Restaurante Demo <reservas@tudominio.com>

# WhatsApp transaccional — Meta Cloud API (https://developers.facebook.com)
# Deja las dos vacías para deshabilitar los WhatsApp de confirmación/cancelación.
# Requiere además que las plantillas "reservation_confirmation" y
# "reservation_cancellation" existan y estén aprobadas en el WABA
# (ver scripts/setup-whatsapp-templates.mjs). Con el número de prueba de
# Meta, el destinatario debe estar en la lista de "recipient numbers"
# verificados de la app, o Meta rechaza el envío.
META_WHATSAPP_TOKEN=...
META_WHATSAPP_PHONE_NUMBER_ID=...
