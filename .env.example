# Supabase — obtenidos en https://supabase.com/dashboard/project/<id>/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Sólo necesario para scripts de servidor (nunca en el cliente)
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# URL base de la app (sin barra final)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Slug del restaurante por defecto (debe coincidir con la tabla restaurants)
NEXT_PUBLIC_RESTAURANT_SLUG=restaurante-demo

# Email transaccional — Resend (https://resend.com · free: 3 000 emails/mes)
# Deja vacío para deshabilitar emails de confirmación/cancelación
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=Restaurante Demo <reservas@tudominio.com>

# WhatsApp transaccional — Twilio (https://console.twilio.com)
# Deja las tres vacías para deshabilitar los WhatsApp de confirmación/cancelación.
# En el sandbox de prueba, cada destinatario debe enviar antes "join <código>"
# al número de sandbox desde su WhatsApp, o Twilio rechaza el envío.
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=...
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
